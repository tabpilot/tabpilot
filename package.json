{
  "name": "tabpilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @tabpilot/shared build && concurrently -n shared,api,web -c yellow,cyan,magenta \"yarn workspace @tabpilot/shared dev\" \"yarn workspace @tabpilot/api dev\" \"yarn workspace @tabpilot/web dev\"",
    "build": "yarn workspaces foreach -t --exclude '@tabpilot/docs' run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "yarn workspace @tabpilot/shared build && yarn workspaces foreach -A --exclude '@tabpilot/e2e' --exclude '@tabpilot/shared' --exclude '@tabpilot/docs' run typecheck",
    "test": "yarn workspaces foreach -A --exclude '@tabpilot/e2e' --exclude '@tabpilot/docs' run test --passWithNoTests",
    "test:api": "yarn workspace @tabpilot/api test",
    "test:api:cov": "yarn workspace @tabpilot/api test:cov",
    "test:web": "yarn workspace @tabpilot/web test",
    "test:web:cov": "yarn workspace @tabpilot/web test:cov",
    "test:e2e": "yarn workspace @tabpilot/e2e test",
    "test:e2e:github": "yarn workspace @tabpilot/e2e test:github",
    "clean": "yarn workspaces foreach --exclude '@tabpilot/docs' run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "concurrently": "^10.0.4",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "fastify": "^5.8.5",
    "picomatch": "^4.0.4",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "serialize-javascript": "^7.0.5",
    "esbuild": "^0.25.0",
    "follow-redirects": "^1.16.0",
    "engine.io": "^6.6.7",
    "ws": "^8.21.0",
    "undici": "^7.28.0",
    "find-my-way": "^9.7.0",
    "fast-uri": "^3.1.5",
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.7.0",
    "protobufjs": "^7.6.5",
    "@protobufjs/utf8": "^1.1.1",
    "@grpc/grpc-js": "^1.13.5",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.3.0",
    "shell-quote": "^1.9.0",
    "tar": "^7.5.19",
    "form-data": "^4.0.6",
    "basic-ftp": "^5.3.1",
    "tmp": "^0.2.6",
    "ip-address": "^10.1.1",
    "postcss": "^8.5.12",
    "react-router/path-to-regexp": "1.9.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
