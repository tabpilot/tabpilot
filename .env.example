# ─── TabPilot — root environment reference ────────────────────────────────────
#
# Copy the per-workspace files for local development:
#
#   cp apps/api/.env.example  apps/api/.env
#   cp apps/web/.env.example  apps/web/.env
#
# Then edit each file with your local values.
#
# ─── Quick reference ──────────────────────────────────────────────────────────
#
# apps/api/.env
# ┌──────────────────────────┬────────────────────────────────────────────────────────────────┬────────────────────────────────────┐
# │ Variable                 │ Description                                                    │ Default / Example                  │
# ├──────────────────────────┼────────────────────────────────────────────────────────────────┼────────────────────────────────────┤
# │ MONGODB_URI              │ MongoDB connection string                                      │ mongodb://localhost:27017/tabpilot │
# │ PORT                     │ API server port                                                │ 3000                               │
# │ FRONTEND_URL             │ Web origin for CORS                                            │ http://localhost:5173              │
# │ NODE_ENV                 │ development | production                                       │ development                        │
# │ JIRA_BASE_URL            │ Jira Cloud base URL (optional — enables title enrichment)      │ https://your-org.atlassian.net     │
# │ JIRA_USER_EMAIL          │ Jira user email for Basic auth                                 │ you@company.com                    │
# │ JIRA_API_TOKEN           │ Jira API token (from id.atlassian.com)                         │ your_jira_api_token_here           │
# │ JIRA_STORY_POINTS_FIELDS │ Per-project story-points field map (optional — enables Jira    │ CONNCERT=customfield_10016,        │
# │                          │ write-back). Format: PROJ=fieldName,PROJ2=fieldName2.          │ PAD=story_points                   │
# │                          │ Use customfield_10016 for classic projects, story_points       │                                    │
# │                          │ for team-managed projects.                                     │                                    │
# │ JIRA_TEAM_FIELD          │ Team custom field id (optional — discovered when unset)        │ customfield_10001                  │
# └──────────────────────────┴────────────────────────────────────────────────────────────────┴────────────────────────────────────┘
#
# apps/web/.env
# ┌──────────────────┬─────────────────────────────────────────────────┬───────────────────────┐
# │ Variable         │ Description                                     │ Default               │
# ├──────────────────┼─────────────────────────────────────────────────┼───────────────────────┤
# │ VITE_API_URL     │ API base URL (no trailing slash)                │ http://localhost:3000 │
# └──────────────────┴─────────────────────────────────────────────────┴───────────────────────┘
