# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string.
# For local dev, start MongoDB with: podman compose -f compose.dev.yml up -d
MONGODB_URI=mongodb://localhost:27017/tabpilot

# For production (replica set / Atlas):
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/tabpilot?retryWrites=true&w=majority

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the API listens on. Containerfile exposes 3000.
PORT=3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the web frontend. Used for CORS allow-list.
# In production (single container) the API serves the SPA itself, so set this
# to the same origin as the API.
FRONTEND_URL=http://localhost:5173

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" in container deployments.
# In production, the API also serves the React SPA from apps/web/dist.
NODE_ENV=development

# ─── Proxy / Rate Limiting ────────────────────────────────────────────────────
# Set to "true" when the API runs behind a trusted reverse proxy (nginx, HAProxy,
# OpenShift route, etc.). Reads the real client IP from X-Forwarded-For /
# X-Real-IP for accurate per-IP rate limiting.
# WARNING: only enable this if you control the proxy. Spoofed headers can bypass
# rate limiting if the API is directly internet-facing.
ALLOW_PROXY=false

# ─── Jira Integration (optional) ──────────────────────────────────────────────
# When set, Jira issue titles are fetched and displayed in the URL queue.
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token_here

# ─── Jira Story Points (optional) ─────────────────────────────────────────────
# Comma-separated list of PROJECT_KEY=field_name pairs.
# Enables the "Copy to Jira" button for story points on matching tickets.
#
# The field name depends on your Jira project type:
#   - Team-managed (next-gen) projects:   story_points
#   - Company-managed (classic) projects: customfield_10016  (check your Jira field config)
#
# Example — two projects, different field names:
# JIRA_STORY_POINTS_FIELDS=AMB=customfield_10016,PAC=story_points
JIRA_STORY_POINTS_FIELDS=

# ─── Jira Extra Fields (optional) ────────────────────────────────────────────
# JSON object mapping project keys to extra fields sent alongside story points.
# Supports any Jira field value type (numbers, strings, select options, etc.).
#
# Example — set a select field when story points are saved:
# JIRA_EXTRA_FIELDS={"MYPROJ":{"customfield_10517":{"id":"10852"}}}
#
# Example — multiple fields on one project:
# JIRA_EXTRA_FIELDS={"MYPROJ":{"customfield_10517":{"id":"10852"},"customfield_10099":1}}
JIRA_EXTRA_FIELDS=

# ─── Jira Team (optional) ─────────────────────────────────────────────────────
# Custom field id for the Jira "Team" field. When unset, Tab Pilot looks up the
# Atlassian Team field automatically and includes its name on each issue.
# Set this only when that lookup picks the wrong field.
# JIRA_TEAM_FIELD=customfield_10001
JIRA_TEAM_FIELD=

# ─── AI Ticket Scoring (optional) ────────────────────────────────────────────
# Path to a GCP service account JSON key file with Vertex AI access.
# When set, Jira tickets are scored on six quality dimensions using Gemini Flash.
# The project ID is read from the key file automatically.
GOOGLE_APPLICATION_CREDENTIALS=
# Vertex AI region (defaults to us-central1).
VERTEX_AI_LOCATION=us-central1
# Gemini model name (defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
